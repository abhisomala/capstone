import requests
import json
import os

# API URL
url = "https://modis.ornl.gov/rst/api/v1/"
header = {'Accept': 'application/json'}

# Location
latitude = 27.9944024
longitude = -81.7602544

# MODIS product 
product = 'MYD09A1'
band = 'sur_refl_b01'  

# Gets dates for location
response = requests.get(f'{url}{product}/dates?latitude={latitude}&longitude={longitude}', headers=header)
dates = json.loads(response.text)['dates']

# Extract the last 10 dates
modis_dates = [i['modis_date'] for i in dates[-10:]]

#Save the images to desktop
desktop_path = os.path.expanduser('~') + '/Desktop/algae_bloom_dataset'
os.makedirs(desktop_path, exist_ok=True)

# Loop through dates and fetch data
for date in modis_dates:
    response = requests.get(f'{url}{product}/subset?latitude={latitude}&longitude={longitude}&band={band}&startDate={date}&endDate={date}&kmAboveBelow=10&kmLeftRight=10', headers=header)
    subset = json.loads(response.text)

    if 'subset' in subset and subset['subset']:
        satellite_data = subset['subset'][0]['data']
        if satellite_data:  
            image_filename = f"{desktop_path}/algae_bloom_{date}.json"
            with open(image_filename, 'w') as file:
                json.dump(satellite_data, file)
            print(f" Saved image data for {date} to {image_filename}")
        else:
            print(f"No valid data for {date}. Skipping...")
    else:
        print(f" No data found for {date}. Skipping...")

print("Satellite data saved.")
